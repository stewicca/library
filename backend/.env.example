# ── Server ─────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update

# ── Redis (refresh tokens + access-token blacklist) ────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ────────────────────────────────────────────────
# Generate a strong secret, e.g.:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=library-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_HOURS=168

# ── Refresh-token cookie ───────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth

# ── CORS (comma-separated origins) ─────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Bootstrap admin (seeded once on startup) ───────────
ADMIN_SEED_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
